meta {
  name: Listar todos anuncios
  type: http
  seq: 1
}

get {
  url: http://localhost:8081/api/v1/anuncios?cidade=sao-paulo
  body: none
  auth: none
}

params:query {
  cidade: sao-paulo
  ~quarto: 3
  ~tipo: EM_OBRAS
  ~ativo: True
  ~regiao: Sudeste
}

docs {
  This request retrieves a list of users from the JSONPlaceholder API.
